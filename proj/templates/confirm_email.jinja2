{% extends 'base.jinja2' %}
{% block body %}
<div class="container main-container">
    <br>
    <div class="container">
        <div class="d-flex justify-content-center h-100">
            <div class="card">
                <div class="card-header">
                    Resend Confirmation Email
                </div>
                <div class="card-body">
                    {% for message in get_flashed_messages() %}
                    <div class="alert alert-warning">
                        <button
                        type="button"
                        class="close"
                        data-dismiss="alert">
                            x
                        </button>
                        {{ message }}
                    </div>
                    {% endfor %}
                    <div class="container">
                        <form id="sign-up-form" method="POST" action="{{ url_for('auth.confirm_email') }}">
                            {{form.csrf_token}}
                            
                            <div class="form-group">
                                <fieldset>
                                    {{form.email.label}}
                                    {{form.email}}
                                    {% if form.email.errors %}
                                    <ul class="errors">
                                        {% for error in form.email.errors %}
                                        <li>{{ error }}</li>{% endfor %}
                                    </ul>
                                    {% endif %}
                                </fieldset>
                            </div>
                        
                            <div class="form-group submit-button">
                                <fieldset>
                                    {{form.submit}}
                                </fieldset>
                            </div>

                        </form>
                    </div>
                    <div class="container row">
                        <div class="col-sm-4">
                            <a href="{{url_for('auth.signup')}}" class="btn btn-light">Sign up</a>
                        </div>
                        <div class="col-sm-4">
                            <a href="{{url_for('auth.signin')}}" class="btn btn-light">Sign in</a>
                        </div>
                        <div class="col-sm-4">
                            <a href="{{url_for('auth.reset_request')}}" class="btn btn-light">Forgot Password?</a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}