{% extends 'base.jinja2' %}
{% from 'auth-fields.jinja2' import field_input, flash_messages %}
{% block body %}
<section class="auth-layout">
    <span class="eyebrow">SMC BMP / Agency access</span>
    <h1>Create an account</h1>
    {{flash_messages(get_flashed_messages())}}
    <form id="sign-up-form" method="POST" action="{{url_for('auth.signup')}}">
        {{form.csrf_token}}
        {{field_input(form.firstname)}}
        {{field_input(form.lastname)}}
        {{field_input(form.email)}}
        {{field_input(form.organization)}}
        {{field_input(form.password)}}
        {{field_input(form.confirm)}}
        <p class="text-muted">Email confirmation and SCCWRP approval are required for agency access.</p>
        <div class="form-group">{{form.submit}}</div>
    </form>
    <div class="auth-links"><a href="{{url_for('auth.signin')}}">Already registered? Sign in</a><a href="mailto:IT@sccwrp.org">Contact support</a></div>
</section>
{% endblock %}