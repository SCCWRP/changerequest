{% extends 'base.jinja2' %}
{% block body %}
<section class="receipt">
    {% if success %}
    <div class="receipt-mark" aria-hidden="true"><i class="icon icon-check"></i></div>
    <span class="eyebrow">Pending staff review</span>
    <h1>{{ 'Deletion' if request_type == 'delete' else 'Change' }} request received</h1>
    <p>SCCWRP will review your request. No production data has changed. A receipt has been sent to {{session_user_email}}.</p>
    <dl class="receipt-details">
        <div><dt>Change request</dt><dd class="mono">{{change_id}}</dd></div>
        <div><dt>Submission</dt><dd class="mono">{{submissionid}}</dd></div>
        <div><dt>Datatype</dt><dd>{{datatype}}</dd></div>
        <div><dt>Original submission date</dt><dd>{{submissiondate}}</dd></div>
        {% for key, value in login_fields.items() %}<div><dt>{{key}}</dt><dd>{{value}}</dd></div>{% endfor %}
    </dl>
    {% else %}
    <h1>Request not completed</h1>
    <p>Contact SCCWRP with your change request ID for assistance.</p>
    {% endif %}
    <a class="btn btn-primary" href="{{url_for('login.index')}}"><i class="icon icon-arrow-left" aria-hidden="true"></i> Back to submissions</a>
</section>
{% endblock %}