{% extends 'base.jinja2' %}
{% block head %}
{{ super() }}
<link rel="stylesheet" href="{{url_for('static', filename='edit_submission.css')}}">
{% endblock %}
{% block body %}
<div class="workspace editor-workspace">
    <a class="breadcrumb-link" href="{{url_for('login.index')}}"><i class="icon icon-arrow-left" aria-hidden="true"></i> Submissions</a>
    <div class="page-heading editor-heading">
        <div>
            <span class="eyebrow">{{config.get('dtypes', {}).get(session.get('dtype'), {}).get('human_friendly_dtype_name', 'Submission editor')}}</span>
            <h1>Submission <span class="mono">{{session['submissionid']}}</span></h1>
            <span id="workflow-status" class="workflow-status">Awaiting workbook</span>
        </div>
        <button type="button" id="request-deletion" class="btn btn-outline-danger btn-sm"><i class="icon icon-trash-2" aria-hidden="true"></i> Request submission deletion</button>
    </div>
    <dl class="submission-meta">
        {% for field, value in login_fields.items() %}
        <div><dt>{{field|replace('_', ' ')}}</dt><dd id="current-{{field}}">{{value}}</dd></div>
        {% endfor %}
        {% if session.get('submissiondate') %}<div><dt>Submitted</dt><dd>{{session['submissiondate']}}</dd></div>{% endif %}
        <div><dt>Tables</dt><dd>{{pkeys|length}}</dd></div>
    </dl>
    {% if pending_deletion %}<p class="alert alert-warning"><strong>Pending deletion request.</strong> An unprocessed deletion request exists for this submission. Further edit requests are still allowed.</p>{% endif %}
    <section class="workbook-toolbar" aria-label="Submission workbook">
        <div class="download-section">
            <div class="section-label"><span class="step-number">01</span> Original workbook</div>
            <a href="{{url_for('export.download_submission')}}" class="btn"><i class="icon icon-download" aria-hidden="true"></i> Download workbook</a>
        </div>
        <div class="upload-section">
            <div class="section-label"><span class="step-number">02</span> Revised workbook</div>
            <form method="post" enctype="multipart/form-data" id="upload-form" class="upload-form">
                <div class="file-picker">
                    <i class="icon icon-file-spreadsheet" aria-hidden="true"></i>
                    <label for="file"><strong>Choose file</strong><span id="selected-filename">No workbook selected</span></label>
                    <input id="file" type="file" name="files[]" accept=".xlsx" required aria-describedby="selected-filename">
                </div>
                <button type="submit" class="btn btn-primary" id="compare-button"><i class="icon icon-upload" aria-hidden="true"></i> Compare workbook</button>
            </form>
        </div>
    </section>
    <details class="submission-rules">
        <summary>Editing rules &amp; record identifiers</summary>
        <div>
            <p>A primary-key change is treated as a deleted record and an added record. Existing provenance fields cannot be changed. Production changes require SCCWRP review.</p>
            <dl>{% for table, columns in pkeys.items() %}<div><dt>{{table}}</dt><dd>{{columns|join(', ')}}</dd></div>{% endfor %}</dl>
        </div>
    </details>
    <section class="review-section" aria-labelledby="review-heading">
        <div class="review-title">
            <h2 id="review-heading"><span class="step-number">03</span> Change review</h2>
            <div class="review-legend hidden" id="review-legend"><span><i class="legend-swatch" aria-hidden="true"></i> Accepted change</span><span><i class="legend-swatch error" aria-hidden="true"></i> Needs correction</span></div>
        </div>
        <p id="request-status" class="status-message" role="status" aria-live="polite"></p>
        <div id="review-placeholder" class="review-placeholder">
            <div><i class="icon icon-table-2" aria-hidden="true"></i><h3>No comparison yet</h3><p>Your original submission is unchanged.</p></div>
        </div>
        <div id="change-report-container" class="hidden">
            <div class="report-toolbar">
                <div class="table-selector-field"><label for="report-table-selector">Submission table</label><select id="report-table-selector" class="form-control"></select></div>
                <p id="report-counts"></p>
            </div>
            <p id="report-primary-key"></p>
            <div id="report-warnings" role="status"></div>
            <div id="datatable-tabs" role="tablist" aria-label="Record changes">
                <button type="button" id="changed-tab" class="btn datatable-tab-button active" role="tab" aria-selected="true" aria-controls="changed-records-datatable-container" data-target="changed-records-datatable-container">Changed <span id="changed-count" class="tab-count">0</span></button>
                <button type="button" id="added-tab" class="btn datatable-tab-button" role="tab" aria-selected="false" aria-controls="added-records-datatable-container" data-target="added-records-datatable-container">Added <span id="added-count" class="tab-count">0</span></button>
                <button type="button" id="deleted-tab" class="btn datatable-tab-button" role="tab" aria-selected="false" aria-controls="deleted-records-datatable-container" data-target="deleted-records-datatable-container">Deleted <span id="deleted-count" class="tab-count">0</span></button>
            </div>
            <div class="datatable-container changedrecords active" id="changed-records-datatable-container" role="tabpanel" aria-labelledby="changed-tab">
                <div id="changed-records-display-inner-container" class="records-display-inner-container" tabindex="0" aria-label="Changed records"></div>
            </div>
            <div class="datatable-container addedrecords" id="added-records-datatable-container" role="tabpanel" aria-labelledby="added-tab">
                <div id="added-records-display-inner-container" class="records-display-inner-container" tabindex="0" aria-label="Added records"></div>
            </div>
            <div class="datatable-container deletedrecords" id="deleted-records-datatable-container" role="tabpanel" aria-labelledby="deleted-tab">
                <div id="deleted-records-display-inner-container" class="records-display-inner-container" tabindex="0" aria-label="Deleted records"></div>
            </div>
        </div>
        <div class="review-actions hidden" id="review-actions">
            <span class="action-caption">Pending staff review</span>
            <button id="save-change-btn" type="button" class="btn hidden post-change-option"><i class="icon icon-save" aria-hidden="true"></i> Save corrections</button>
            <form action="{{url_for('export.download_change_history')}}" method="GET" target="_blank">
                <button id="submit-submission" type="submit" class="btn hidden post-change-option clean-data-post-change-option"><i class="icon icon-download" aria-hidden="true"></i> Change summary</button>
            </form>
            <form id="final-submit-form" action="{{url_for('finalize.savechanges')}}" method="POST">
                <input type="hidden" name="comment" id="final-comment">
                <input type="hidden" name="confirmation" id="final-confirmation">
                <input type="hidden" name="revision" id="final-revision">
                <button id="finalize-submission" type="submit" class="btn btn-primary hidden post-change-option clean-data-post-change-option"><i class="icon icon-send" aria-hidden="true"></i> <span id="finalize-label">Submit change request</span></button>
            </form>
        </div>
    </section>
</div>
<dialog id="deletion-dialog" class="request-dialog" aria-labelledby="deletion-title">
    <form method="dialog">
        <div class="dialog-heading"><h2 id="deletion-title">Delete this submission?</h2><button type="submit" value="cancel" class="dialog-close" aria-label="Close"><i class="icon icon-x" aria-hidden="true"></i></button></div>
        <div class="dialog-body"><p>Prepare a deletion request for all records in submission <strong>{{session['submissionid']}}</strong>. This replaces the current comparison.</p><p>No data is deleted until SCCWRP staff review and apply the request.</p></div>
        <div class="dialog-actions"><button type="submit" value="cancel" class="btn">Cancel</button><button type="submit" value="prepare" class="btn btn-danger"><i class="icon icon-trash-2" aria-hidden="true"></i> Prepare deletion</button></div>
    </form>
</dialog>
<dialog id="finalize-dialog" class="request-dialog" aria-labelledby="finalize-title">
    <form id="finalize-details-form">
        <div class="dialog-heading"><h2 id="finalize-title">Submit change request</h2><button type="button" class="dialog-close" data-close-finalize aria-label="Close"><i class="icon icon-x" aria-hidden="true"></i></button></div>
        <div class="dialog-body">
            <p id="finalize-description">SCCWRP staff will review this request before applying changes.</p>
            <div class="dialog-context">Submission {{session['submissionid']}}</div>
            <div class="field"><label for="request-comment">Reason for this request <span class="text-muted">(required)</span></label><textarea id="request-comment" required placeholder="Describe the reason for these changes."></textarea></div>
            <div class="field hidden" id="deletion-confirmation-field"><label for="deletion-confirmation">Type {{session['submissionid']}} to confirm deletion</label><input id="deletion-confirmation" type="text" inputmode="numeric" autocomplete="off"></div>
            <p id="finalize-error" class="alert alert-danger mt-3" role="alert"></p>
        </div>
        <div class="dialog-actions"><button type="button" class="btn" data-close-finalize>Cancel</button><button type="submit" id="send-request-button" class="btn btn-primary"><i class="icon icon-send" aria-hidden="true"></i> Send request</button></div>
    </form>
</dialog>
<div id="loading-modal" class="loading-overlay" role="status" aria-live="polite" aria-label="Processing request"><div class="loading-panel"><img src="{{url_for('static', filename='loader.gif')}}" alt=""><strong>Processing your request</strong><p>Please keep this page open.</p></div></div>
{% endblock %}
{% block tooltip %}<div class="tooltip" id="changed-cell-tooltip" role="tooltip"><div class="title"></div><div class="content"></div></div>{% endblock %}
{% block scripts %}
{{ super() }}
<script id="submission-context" type="application/json">{{ {'submissionid': session['submissionid'], 'pkeys': pkeys}|tojson }}</script>
<script src="{{url_for('static', filename='format_table.js')}}"></script>
<script type="module" src="{{url_for('static', filename='edit_submission.js')}}"></script>
<script type="module" src="{{url_for('static', filename='save.js')}}"></script>
{% endblock %}