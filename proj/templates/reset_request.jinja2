{% extends 'base.jinja2' %}
{% from 'auth-fields.jinja2' import field_input, flash_messages %}
{% block body %}
<section class="auth-layout">
    <span class="eyebrow">{{config.get('projectname', '')}} / Account recovery</span>
    <h1>Reset your password</h1>
    {{flash_messages(get_flashed_messages())}}
    <form id="sign-up-form" method="POST" action="{{url_for('auth.reset_request')}}">
        {{form.csrf_token}}
        {{field_input(form.email)}}
        <div class="form-group">{{form.submit}}</div>
    </form>
    <div class="auth-links"><a href="{{url_for('auth.signin')}}"><i class="icon icon-arrow-left" aria-hidden="true"></i> Back to sign in</a></div>
</section>
{% endblock %}