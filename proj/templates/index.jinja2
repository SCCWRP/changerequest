{% extends 'base.jinja2' %}
{% block body %}
<div class="workspace search-workspace">
    <div class="page-heading">
        <div><span class="eyebrow">Submission workspace</span><h1>Find a submission</h1>{% if config.get('branding', {}).get('summary') %}<p>{{config['branding']['summary']}}</p>{% endif %}</div>
        <span class="text-muted">Change requests <span aria-hidden="true">/</span> Submission lookup</span>
    </div>
    <div class="search-layout">
        <section class="search-panel" id="login-form-container" aria-labelledby="search-heading">
            <div class="search-panel-heading"><h2 id="search-heading">Submission lookup</h2></div>
            <nav class="datatype-tabs" aria-label="Datatype">
                {% for dtype, settings in dtypes.items() %}
                <button type="button" class="infotab-header{% if loop.first %} active{% endif %}" id="{{dtype}}-header" data-dtype="{{dtype}}" aria-pressed="{{ 'true' if loop.first else 'false' }}" aria-controls="{{dtype}}-form-container">{{settings['human_friendly_dtype_name']}}</button>
                {% endfor %}
            </nav>
            {% for dtype, settings in dtypes.items() %}
            <div class="form-container{% if not loop.first %} hidden{% endif %}" id="{{dtype}}-form-container" data-dtype="{{dtype}}">
                <form class="fetch-submission-form" id="{{dtype}}-form" data-dtype="{{dtype}}">
                    <div class="search-fields">
                        {% for field in settings['login_fields'] %}
                        <div class="field">
                            <label for="{{dtype}}-{{field.fieldname}}-{{field.fieldtype}}">{{field.fieldlabel or field.fieldname}}</label>
                            {% if field.fieldtype == 'select' %}
                            <select name="{{field.fieldname}}" id="{{dtype}}-{{field.fieldname}}-{{field.fieldtype}}" class="login-field-element" data-dtype="{{dtype}}" data-index="{{loop.index}}" required disabled>
                                <option value="">{{ 'Loading options...' if loop.first else 'Select previous field first' }}</option>
                            </select>
                            {% else %}
                            <input name="{{field.fieldname}}" id="{{dtype}}-{{field.fieldname}}-{{field.fieldtype}}" class="login-field-element" data-dtype="{{dtype}}" data-index="{{loop.index}}" required>
                            {% endif %}
                        </div>
                        {% endfor %}
                        <div class="field submission-field">
                            <label for="{{dtype}}-submissionid-select">Submission</label>
                            <select name="submissionid" id="{{dtype}}-submissionid-select" class="login-field-element" data-dtype="{{dtype}}" required disabled>
                                <option value="">Select {% for field in settings['login_fields'] %}{{(field.fieldlabel or field.fieldname)|lower}}{{' and ' if not loop.last}}{% endfor %} first</option>
                            </select>
                        </div>
                    </div>
                    <div class="search-submit">
                        <p id="{{dtype}}-submission-message" class="status-message" role="status" aria-live="polite"></p>
                        <button type="submit" id="{{dtype}}-form-submit" class="btn btn-primary login_btn" value="edit" disabled>Open submission <i class="icon icon-arrow-right" aria-hidden="true"></i></button>
                    </div>
                </form>
            </div>
            {% endfor %}
        </section>
        <aside class="search-aside" aria-label="Submission access">
            <span class="eyebrow">Your workspace</span>
            <h3>{{current_user.organization}}</h3>
            <dl>
                <div><i class="icon icon-building-2" aria-hidden="true"></i><span><dt>Agency access</dt><dd>{{ 'Administrator' if current_user.is_admin == 'yes' else 'Authorized agency editor' }}</dd></span></div>
                <div><i class="icon icon-circle-check" aria-hidden="true"></i><span><dt>Submission status</dt><dd>Completed, non-deleted submissions</dd></span></div>
                <div><i class="icon icon-clipboard-check" aria-hidden="true"></i><span><dt>Final review</dt><dd>SCCWRP data management</dd></span></div>
            </dl>
            <p class="aside-note">Production data changes only after staff review and approval.</p>
        </aside>
    </div>
</div>
<div id="overlay" class="loading-overlay" role="status" aria-live="polite" aria-label="Loading submission">
    <div id="overlay-text-container" class="loading-panel">
        <img src="{{url_for('static', filename='loader.gif')}}" alt="">
        <strong>Opening submission</strong><p>Preparing your workbook&hellip;</p>
    </div>
</div>
{% endblock %}
{% block scripts %}
{{ super() }}
<script src="{{url_for('static',filename='login_form.js')}}"></script>
{% endblock %}